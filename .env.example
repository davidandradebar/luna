# Copiar a .env y completar con valores locales. Nunca subir .env al repositorio.
FLASK_ENV=development
SECRET_KEY=cambiar-por-un-valor-aleatorio

POSTGRES_DB=luna
POSTGRES_USER=luna
POSTGRES_PASSWORD=cambiar-localmente
DATABASE_URL=postgresql+psycopg://luna:cambiar-localmente@db:5432/luna

REDIS_URL=redis://redis:6379/0
RQ_QUEUE=rosters

# Integración con la plataforma de WhatsApp (pendiente)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
